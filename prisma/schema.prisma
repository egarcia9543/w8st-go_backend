generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// ¿Entró o salió dinero?
enum Direction {
  OUTFLOW
  INFLOW
}

/// ¿De dónde salió la plata?
/// OWN_FUNDS  -> débito, cuenta, transferencias: dinero propio, sale del bolsillo
/// CREDIT     -> tarjeta de crédito: es deuda, no bolsillo
/// INTERNAL   -> traslado entre bolsillos propios (pago de TC, ahorros -> corriente).
///               No es gasto ni ingreso; se excluye para no contar doble.
enum FundingSource {
  OWN_FUNDS
  CREDIT
  INTERNAL
}

enum CardKind {
  CREDIT
  DEBIT
  ACCOUNT
}

/// Un instrumento de pago: tarjeta de crédito, débito o cuenta.
/// last4 por sí solo no identifica nada: puedes tener una débito y una crédito
/// terminadas en los mismos 4 dígitos. Por eso la unicidad es [last4, kind].
model Card {
  id        String   @id @default(cuid())
  last4     String
  kind      CardKind
  alias     String?
  issuer    String?  @default("Bancolombia")
  cutoffDay Int?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([last4, kind])
}

model Transaction {
  id             String @id @default(cuid())
  gmailMessageId String @unique
  type           String
  amount         Float
  currency       String @default("COP")

  /// @deprecated Lo reemplazan direction + fundingSource + card.
  /// Se sigue poblando para no romper el front hasta la Fase 3.
  paymentMethod String?

  merchant         String?
  instrumentLast4  String?
  channel          String?
  counterpartyName String?
  counterpartyKey  String?
  transactionDate  DateTime
  createdAt        DateTime @default(now())

  direction     Direction     @default(OUTFLOW)
  fundingSource FundingSource @default(OWN_FUNDS)
  cardId        String?
  card          Card?         @relation(fields: [cardId], references: [id])

  /// Traslados internos y cualquier cosa que no deba sumar al gasto.
  excludeFromSpending Boolean @default(false)

  /// Editada a mano desde la UI: un re-sync no la debe pisar.
  manualOverride Boolean @default(false)

  /// Qué regla del parser la produjo. Trazabilidad para depurar.
  ruleName String?

  @@index([transactionDate])
  @@index([cardId])
}

/// Correo que el parser no supo interpretar. Sin esto los fallos se pierden
/// en un console.warn y no hay forma de saber qué plantilla falta.
model UnparsedEmail {
  id             String    @id @default(cuid())
  gmailMessageId String    @unique
  subject        String
  fromAddress    String
  snippet        String
  bodyText       String
  receivedAt     DateTime
  reason         String
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([resolvedAt])
}

model GmailSync {
  id        String   @id @default(cuid())
  historyId String
  updatedAt DateTime @updatedAt
}

model OAuthToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
