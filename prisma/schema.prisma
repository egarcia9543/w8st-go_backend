generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  googleSub    String?  @unique
  picture      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions   Transaction[]
  cards          Card[]
  unparsedEmails UnparsedEmail[]
  oauthToken     OAuthToken?
  gmailSync      GmailSync?
  wishlistTiers  WishlistTier[]
  wishlistItems  WishlistItem[]
  budgetGroups     BudgetGroup[]
  categories       Category[]
  referenceIncomes ReferenceIncome[]
  debts            Debt[]
  debtPayments     DebtPayment[]
}

enum Direction {
  OUTFLOW
  INFLOW
}

enum FundingSource {
  OWN_FUNDS
  CREDIT
  INTERNAL
}

enum CardKind {
  CREDIT
  DEBIT
  ACCOUNT
}

model Card {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4            String
  kind             CardKind
  alias            String?
  issuer           String?  @default("Bancolombia")
  cutoffDay        Int?
  paymentGraceDays Int?
  creditLimit      Float?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId, last4, kind])
  @@index([userId])
}

model Transaction {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  type           String
  amount         Float
  currency       String @default("COP")

  paymentMethod String?

  merchant         String?
  instrumentLast4  String?
  channel          String?
  counterpartyName String?
  counterpartyKey  String?
  transactionDate  DateTime
  createdAt        DateTime @default(now())

  direction     Direction     @default(OUTFLOW)
  fundingSource FundingSource @default(OWN_FUNDS)
  cardId        String?
  card          Card?         @relation(fields: [cardId], references: [id])

  excludeFromSpending Boolean @default(false)
  manualOverride      Boolean @default(false)
  ruleName            String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([userId, transactionDate])
  @@index([cardId])
  @@index([userId, categoryId])
}

enum BudgetGroupKind {
  SPENDING
  SAVINGS
}

model BudgetGroup {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  kind          BudgetGroupKind @default(SPENDING)
  targetPercent Float
  color         String
  position      Int

  categories Category[]

  @@unique([userId, name])
}

model Category {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String
  groupId      String?
  group        BudgetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  monthlyLimit Float?
  archived     Boolean      @default(false)
  position     Int

  transactions Transaction[]

  @@unique([userId, name])
}

model UnparsedEmail {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  subject        String
  fromAddress    String
  snippet        String
  bodyText       String
  receivedAt     DateTime
  reason         String
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, gmailMessageId])
  @@index([userId, resolvedAt])
}

model GmailSync {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyId String
  updatedAt DateTime @updatedAt
}

model ReferenceIncome {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  effectiveFrom String
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

enum WishlistStatus {
  WANTED
  BOUGHT
  DISCARDED
}

model WishlistTier {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  color    String
  position Int

  items WishlistItem[]

  @@unique([userId, position])
}

model WishlistItem {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId     String
  tier       WishlistTier   @relation(fields: [tierId], references: [id])
  name       String
  price      Float
  currency   String         @default("COP")
  productUrl String?
  imageUrl   String?
  notes      String?
  position   Int
  status     WishlistStatus @default(WANTED)
  boughtAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, status])
  @@index([tierId, position])
}

model OAuthToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

enum DebtKind {
  CREDIT_CARD
  LOAN
  OTHER
}

model Debt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  kind           DebtKind @default(OTHER)
  balance        Float
  annualRate     Float
  monthlyPayment Float
  paidByOther    Boolean  @default(false)
  notes          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments DebtPayment[]

  @@index([userId, archived])
}

model DebtPayment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime
  createdAt DateTime @default(now())

  @@index([debtId, paidAt])
}
