generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  googleSub    String?  @unique
  picture      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions   Transaction[]
  cards          Card[]
  unparsedEmails UnparsedEmail[]
  oauthToken     OAuthToken?
  gmailSync      GmailSync?
  wishlistTiers  WishlistTier[]
  wishlistItems  WishlistItem[]
}

enum Direction {
  OUTFLOW
  INFLOW
}

enum FundingSource {
  OWN_FUNDS
  CREDIT
  INTERNAL
}

enum CardKind {
  CREDIT
  DEBIT
  ACCOUNT
}

model Card {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  last4            String
  kind             CardKind
  alias            String?
  issuer           String?  @default("Bancolombia")
  cutoffDay        Int?
  paymentGraceDays Int?
  creditLimit      Float?
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId, last4, kind])
  @@index([userId])
}

model Transaction {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  type           String
  amount         Float
  currency       String @default("COP")

  paymentMethod String?

  merchant         String?
  instrumentLast4  String?
  channel          String?
  counterpartyName String?
  counterpartyKey  String?
  transactionDate  DateTime
  createdAt        DateTime @default(now())

  direction     Direction     @default(OUTFLOW)
  fundingSource FundingSource @default(OWN_FUNDS)
  cardId        String?
  card          Card?         @relation(fields: [cardId], references: [id])

  excludeFromSpending Boolean @default(false)
  manualOverride      Boolean @default(false)
  ruleName            String?

  @@unique([userId, gmailMessageId])
  @@index([userId, transactionDate])
  @@index([cardId])
}

model UnparsedEmail {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  subject        String
  fromAddress    String
  snippet        String
  bodyText       String
  receivedAt     DateTime
  reason         String
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, gmailMessageId])
  @@index([userId, resolvedAt])
}

model GmailSync {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyId String
  updatedAt DateTime @updatedAt
}

enum WishlistStatus {
  WANTED
  BOUGHT
  DISCARDED
}

model WishlistTier {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  color    String
  position Int

  items WishlistItem[]

  @@unique([userId, position])
}

model WishlistItem {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId     String
  tier       WishlistTier   @relation(fields: [tierId], references: [id])
  name       String
  price      Float
  currency   String         @default("COP")
  productUrl String?
  imageUrl   String?
  notes      String?
  position   Int
  status     WishlistStatus @default(WANTED)
  boughtAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, status])
  @@index([tierId, position])
}

model OAuthToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
